{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "hooks/src/**/*.mts",
    "hooks/**/*.test.ts",
    "hooks/tsup.config.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "generated", "hooks/*.mjs"]
}
