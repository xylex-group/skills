{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grok.com/schemas/grok-marketplace.json",
  "title": "Grok Plugin Marketplace",
  "description": "Schema for a Grok plugin marketplace manifest (.grok-plugin/marketplace.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "owner", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor tooling. Not used by Grok at runtime."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "plugins": {
      "type": "array",
      "description": "Catalog of plugins published by this marketplace.",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "source"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/pluginSource"
        },
        "category": {
          "type": "string",
          "enum": [
            "development",
            "deployment",
            "database",
            "monitoring",
            "observability",
            "security",
            "productivity",
            "design",
            "communication",
            "analytics",
            "other"
          ]
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "author": {
          "$ref": "#/$defs/person"
        },
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "icon": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pluginSource": {
      "description": "Where the plugin files live: local path string, local object, or remote git URL with optional pin.",
      "oneOf": [
        {
          "title": "Local path string",
          "type": "string",
          "minLength": 1,
          "pattern": "^(\\./|../|/|[A-Za-z]:[\\\\/])"
        },
        {
          "$ref": "#/$defs/localSource"
        },
        {
          "$ref": "#/$defs/urlSource"
        }
      ]
    },
    "localSource": {
      "title": "Local path object",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "const": "local"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(\\./|../|/|[A-Za-z]:[\\\\/])"
        }
      }
    },
    "urlSource": {
      "title": "Remote git URL",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url"],
      "properties": {
        "source": {
          "const": "url"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sha": {
          "type": "string",
          "description": "Full 40-char commit SHA. Required when pinned installs are enforced.",
          "pattern": "^[a-f0-9]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Optional subdirectory inside the remote repository."
        }
      }
    }
  }
}
